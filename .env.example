# Variables de entorno de tequio-gateway para desarrollo local.
#
#   cp .env.example .env.dev    # .env.dev está en .gitignore
#
# En desarrollo (APP_ENV vacío o "development") el gateway carga .env.dev
# automáticamente, buscándolo hacia arriba desde el CWD. ENV_FILE=<ruta> fuerza
# otro archivo.
#
# Son las MISMAS variables en todos los destinos (12-factor): docker-compose.yml
# (local), el panel de Coolify (docker-compose.coolify.yml).
#
# NUNCA pongas credenciales reales en este archivo: se commitea.

APP_ENV=development
SERVICE_ENV=dev
LOG_LEVEL=debug
# json | text (default: json en production, text en el resto)
LOG_FORMAT=text

HTTP_PORT=8080
ROUTES_FILE=routes.yaml

# --- Upstreams (uno por Name de app/upstream/registry.go) --------------------
# host:puerto del servicio gRPC. Local: tequio-issues corriendo en tu máquina
# (`make run` o `make up` en su repo, puerto 5000).
UPSTREAM_ISSUES_ADDR=localhost:5000
# Transporte: local/Coolify = plaintext en red interna; Cloud Run = TLS + ID token.
UPSTREAM_TLS=false
# none | google-idtoken (solo Cloud Run; exige UPSTREAM_TLS=true)
UPSTREAM_AUTH=none
# Solo google-idtoken, si el audience no es https://<host del ADDR>:
# UPSTREAM_ISSUES_AUDIENCE=https://issues-service-xxxx.a.run.app

# --- Auth: firebase -------------------------------------------------------
# ID tokens de Firebase Auth: iss https://securetoken.google.com/<proyecto>, aud <proyecto>.
FIREBASE_PROJECT_ID=tequio-app-435b4
# Custom claim con los roles (setCustomUserClaims(uid, {roles: [...]})).
AUTH_ROLES_CLAIM=roles
# Tolerancia de reloj para exp/nbf/iat (máx. 60s).
AUTH_CLOCK_SKEW=30s

# --- Allowlist (rebanada 1: un solo dueño) -----------------------------------
# Emails que pueden usar la API, separados por coma (sin distinguir mayúsculas).
# El ID token tiene que traer ese `email` con `email_verified=true`; si no, 403.
# VACÍA = NADIE ENTRA (fail closed; el gateway lo avisa al arrancar).
AUTH_ALLOWED_EMAILS=tu-email@ejemplo.com

# SOLO DESARROLLO (exige APP_ENV=development): verifica los tokens contra este
# JWKS en vez del de securetoken (pruebas de punta a punta con un emisor de
# prueba; el iss/aud siguen siendo los de FIREBASE_PROJECT_ID). Nunca en QA/prod.
# FIREBASE_JWKS_URL=http://localhost:9999/jwks

# --- CORS: orígenes EXACTOS permitidos, separados por coma (nunca *) ---------
# Local: tequio-web con `ng serve`. Prod: https://tequio.victorrb1015.com.
# QA: el sitio de Firebase Hosting de QA (a definir). Ver docs/deploy.md.
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOW_CREDENTIALS=false

# --- Proxies propios delante del gateway (X-Forwarded-For) -------------------
# 0 = sin proxy (local). Cloud Run / Traefik (Coolify) = 1.
TRUSTED_PROXY_HOPS=0

# --- OpenAPI en GET /openapi.json (default: true salvo en production) --------
OPENAPI_ENABLED=true

# --- Timeouts del servidor HTTP (anti-slowloris) ----------------------------
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
# Mayor que el timeout más largo de routes.yaml.
HTTP_WRITE_TIMEOUT=35s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
